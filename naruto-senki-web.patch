+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+
+// Text is drawn by the browser's 2D canvas (white, premultiplied like the
+// freetype path below), adapted from cocos2d-x-wasm's
+// Device::getTextureDataForText in platform/emscripten/CCDevice-emscripten.cpp.
+EM_JS(int, cc_text_render, (const char *text, const char *name, int size, int dimW, int dimH, int align, int *outH), {
+	var c = Module.ccTextCanvas = Module.ccTextCanvas || document.createElement('canvas');
+	var ctx = c.getContext('2d', { willReadFrequently: true });
+	var font = size + 'px "' + UTF8ToString(name) + '", sans-serif';
+	var lineH = Math.ceil(size * 1.2);
+	var lines = [];
+	ctx.font = font;
+	UTF8ToString(text).split('\n').forEach(function (s) {
+		var cur = '';
+		Array.from(s).forEach(function (ch) {
+			if (dimW > 0 && cur && ctx.measureText(cur + ch).width > dimW) { lines.push(cur); cur = ''; }
+			cur += ch;
+		});
+		lines.push(cur);
+	});
+	var widths = lines.map(function (s) { return ctx.measureText(s).width; });
+	var w = Math.max(1, dimW > 0 ? dimW : Math.ceil(Math.max.apply(null, widths)));
+	var h = Math.max(1, dimH > 0 ? dimH : lineH * lines.length);
+	var y = 0;
+	if ((align & 0xf0) == 0x30) y = (h - lineH * lines.length) / 2;
+	else if ((align & 0xf0) == 0x20) y = h - lineH * lines.length;
+	c.width = w; c.height = h;
+	ctx.font = font; ctx.fillStyle = '#fff'; ctx.textBaseline = 'top';
+	lines.forEach(function (s, i) {
+		var x = 0;
+		if ((align & 0x0f) == 0x03) x = (w - widths[i]) / 2;
+		else if ((align & 0x0f) == 0x02) x = w - widths[i];
+		ctx.fillText(s, x, y + lineH * i);
+	});
+	HEAP32[outH >> 2] = h;
+	return w;
+});
+
+EM_JS(void, cc_text_copy, (unsigned char *dst), {
+	var c = Module.ccTextCanvas;
+	var d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data;
+	for (var i = 3; i < d.length; i += 4)
+		HEAPU8[dst + i - 3] = HEAPU8[dst + i - 2] = HEAPU8[dst + i - 1] = HEAPU8[dst + i] = d[i];
+});
+
+NS_CC_BEGIN
+
+bool CCImage::initWithString(const char *pText, int nWidth, int nHeight, ETextAlign eAlignMask, const char *pFontName, int nSize)
+{
+	if (!pText)
+		return false;
+	int h = 0;
+	int w = cc_text_render(pText, pFontName ? pFontName : "Arial", nSize, nWidth, nHeight, eAlignMask, &h);
+	m_pData = new unsigned char[w * h * 4];
+	cc_text_copy(m_pData);
+	m_nWidth = (short)w;
+	m_nHeight = (short)h;
+	m_bHasAlpha = true;
+	m_bPreMulti = true;
+	m_nBitsPerComponent = 8;
+	return true;
+}
+
+NS_CC_END
